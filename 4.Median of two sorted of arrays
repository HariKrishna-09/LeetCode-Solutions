class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int n=nums1.length;
        int m=nums2.length;
        int k=0;
        int mer[]=new int[m+n];
        for(int i=0;i<n;i++){
            mer[k++]=nums1[i];
        }
        for(int i=0;i<m;i++){
            mer[k++]=nums2[i];
        }
        Arrays.sort(mer);
        int s=m+n;
        if(s%2==1){
            return (double)mer[s/2];
        }
        else{
            int m1=(s/2)-1;
            int m2=(s/2);
            return (mer[m1]+mer[m2])/2.0;
        }









class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        b=nums1+nums2
        b.sort()
        s=len(b)
        if s%2==1:
            return float(b[s//2])
        else:
            m1=(s//2)-1
            m2=s//2
            return (b[m1]+b[m2])/2.0
    }
}
